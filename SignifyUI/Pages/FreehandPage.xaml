<Page x:Class="Signify.Pages.FreehandPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Freehand Mode"
      Background="#1A1928">

    <!-- ═══════════════════════════════════════════════════════════
         PAGE-LEVEL STYLES
         Defined here so buttons get rounded corners without needing
         a full separate ResourceDictionary file yet.
    ═══════════════════════════════════════════════════════════ -->
    <Page.Resources>

        <!-- Base rounded button — used by all buttons on this page -->
        <Style x:Key="BaseRoundedBtn" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Lighten on hover so the user knows it's clickable -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square icon button — used in the left sidebar -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#2B2B40"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="44"/>
            <Setter Property="Height"      Value="44"/>
            <Setter Property="FontSize"    Value="16"/>
        </Style>

        <!-- Large action button — used in the bottom bar -->
        <Style x:Key="ActionBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Height"      Value="46"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="0"/>
        </Style>

        <!-- Small letter chip button — used in the Suggested panel -->
        <Style x:Key="LetterChipBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#2B2B40"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="38"/>
            <Setter Property="Height"      Value="38"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Margin"      Value="3,3"/>
        </Style>

    </Page.Resources>


    <!-- ═══════════════════════════════════════════════════════════
         ROOT GRID
         Everything is stacked in layers:
           Layer 0 → Camera feed (background)
           Layer 1 → All UI controls on top
    ═══════════════════════════════════════════════════════════ -->
    <Grid>

        <!-- ──────────────────────────────────────────────────────
             LAYER 0 — CAMERA FEED PLACEHOLDER
             Replace this Rectangle + TextBlock with your actual
             camera Image/WritableBitmap control when backend is ready.
        ────────────────────────────────────────────────────────── -->
        <Rectangle x:Name="rectCameraFeed" Fill="#252535"/>
        <TextBlock Text="[ Camera Feed ]"
                   Foreground="#44445A" FontSize="22" FontStyle="Italic"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   IsHitTestVisible="False"/>


        <!-- ──────────────────────────────────────────────────────
             LAYER 1 — ALL UI OVERLAYS
             One big transparent Grid that sits on top of the feed.
        ────────────────────────────────────────────────────────── -->
        <Grid>

            <!-- ════════════════════════════════════════════════
     TOP HEADER BAR
════════════════════════════════════════════════ -->
            <Border x:Name="pnlHeader"
                    VerticalAlignment="Top"
                    Height="60"
                    Background="#0D0D20"
                    BorderThickness="0,0,0,1">

                <Grid Margin="24,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Back -->

                        <ColumnDefinition Width="Auto"/>
                        <!-- App Name -->

                        <ColumnDefinition Width="Auto"/>
                        <!-- Divider -->

                        <ColumnDefinition Width="Auto"/>
                        <!-- Mode -->

                        <ColumnDefinition Width="*"/>
                        <!-- Spacer -->

                        <ColumnDefinition Width="Auto"/>
                        <!-- Right Icons -->
                    </Grid.ColumnDefinitions>

                    <!-- BACK BUTTON -->
                    <Button x:Name="btnBack"
                Grid.Column="0"
                Content="←"
                Style="{StaticResource IconBtn}"
                Width="38"
                Height="38"
                FontSize="16"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                ToolTip="Back to Main Menu"
                Click="btnBack_Click"/>

                    <!-- APP NAME -->
                    <TextBlock x:Name="lblAppName"
                   Grid.Column="1"
                   Text="Signify"
                   Foreground="#7B61FF"
                   FontSize="22"
                   FontWeight="Bold"
                   FontFamily="Segoe UI"
                   VerticalAlignment="Center"/>

                    <!-- DIVIDER -->
                    <Rectangle Grid.Column="2"
                   Width="1"
                   Height="22"
                   Margin="18,0"
                   Fill="#44445C"
                   VerticalAlignment="Center"/>

                    <!-- MODE LABEL -->
                    <TextBlock x:Name="lblModeTitle"
                   Grid.Column="3"
                   Text="Freehand Mode"
                   Foreground="#9A9AB3"
                   FontSize="11"
                   FontWeight="SemiBold"
                   FontFamily="Segoe UI"
                   VerticalAlignment="Center"/>

                    <!-- RIGHT ACTIONS -->
                    <StackPanel Grid.Column="5"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                        <Button x:Name="btnHelp"
                    Content="?"
                    Style="{StaticResource IconBtn}"
                    Width="36"
                    Height="36"
                    Margin="0,0,8,0"
                    ToolTip="Help"/>

                        <Button x:Name="btnSettings"
                    Content="⚙"
                    Style="{StaticResource IconBtn}"
                    Width="36"
                    Height="36"
                    ToolTip="Settings"/>
                    </StackPanel>
                </Grid>
            </Border>


            <!-- ════════════════════════════════════════════════
                 LEFT SIDEBAR
                 Four small icon buttons stacked vertically,
                 centered on the left edge of the screen.
            ════════════════════════════════════════════════ -->
            <StackPanel x:Name="pnlLeftSidebar"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Margin="12,0"
                        Orientation="Vertical">

                <!-- Camera toggle — enables or disables the webcam feed -->
                <Button x:Name="btnCameraToggle"
                        Content="📷"
                        Style="{StaticResource IconBtn}"
                        ToolTip="Toggle Camera"
                        Margin="0,0,0,10"/>

                <!-- Screenshot — captures the current camera frame -->
                <Button x:Name="btnScreenshot"
                        Content="📸"
                        Style="{StaticResource IconBtn}"
                        ToolTip="Take Screenshot"
                        Margin="0,0,0,10"/>

                <!-- Brightness — adjusts camera exposure/brightness -->
                <Button x:Name="btnBrightness"
                        Content="☀"
                        Style="{StaticResource IconBtn}"
                        ToolTip="Adjust Brightness"/>

            </StackPanel>


            <!-- ════════════════════════════════════════════════
                 HAND DETECTION BOX
                 A purple-bordered rounded rectangle rendered on top
                 of the camera feed. This guides the user where to
                 place their hand. Not interactive — IsHitTestVisible=False.
            ════════════════════════════════════════════════ -->
            <Border x:Name="pnlDetectionBox"
                    Width="200" Height="310"
                    BorderBrush="#7B61FF"
                    BorderThickness="2.5"
                    CornerRadius="24"
                    Background="Transparent"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,0,0,70"
                    IsHitTestVisible="False"/>


            <!-- ════════════════════════════════════════════════
                 NEW RECORD NOTIFICATION BADGE  (Top-Right)
                 Appears when the user beats their confidence record.
                 Toggle Visibility between Visible/Collapsed in code-behind.
            ════════════════════════════════════════════════ -->
            <Border x:Name="pnlNewRecord"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,64,178,0"
                    Width="190"
                    Background="#1C1C2E"
                    BorderBrush="#F5C518"
                    BorderThickness="1.5"
                    CornerRadius="9"
                    Padding="11,8"
                    Visibility="Visible">
                <StackPanel Orientation="Horizontal">

                    <!-- Gold star icon -->
                    <TextBlock Text="★"
                               Foreground="#F5C518" FontSize="18"
                               VerticalAlignment="Center"
                               Margin="0,0,9,0"/>

                    <!-- Two-line label: headline + subtitle -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NEW RECORD!"
                                   Foreground="White"
                                   FontSize="11" FontWeight="Bold"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="98.4% Confidence Reached"
                                   Foreground="#8888AA"
                                   FontSize="9"
                                   FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- ════════════════════════════════════════════════
                 RIGHT SIDE PANELS
                 Stacked vertically on the right:
                   1. Session Recap card
                   2. Suggested letters card
            ════════════════════════════════════════════════ -->
            <StackPanel x:Name="pnlRightSide"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        Width="168">

                <!-- ┌─ SESSION RECAP CARD ──────────────────────
                     Shows live session stats: signs sent, accuracy, time.
                     TextBlock Names are set so code-behind can update them.
                ─────────────────────────────────────────────┘ -->
                <Border x:Name="pnlSessionRecap"
                        Background="#20203A"
                        CornerRadius="12"
                        Padding="14,13"
                        Margin="0,0,0,10">
                    <StackPanel>

                        <!-- Section title -->
                        <TextBlock Text="SESSION RECAP"
                                   Foreground="#666688" FontSize="9"
                                   FontWeight="Bold" FontFamily="Segoe UI"
                                   Margin="0,0,0,11"/>

                        <!-- Row: Signs Sent -->
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Signs Sent"
                                       Foreground="#9090AA" FontSize="12" FontFamily="Segoe UI"/>
                            <!-- Bind to ViewModel or update in code-behind -->
                            <TextBlock x:Name="lblSignsSent"
                                       Grid.Column="1"
                                       Text="42"
                                       Foreground="White"
                                       FontSize="12" FontWeight="Bold" FontFamily="Segoe UI"/>
                        </Grid>

                        <!-- Row: Accuracy (highlighted yellow) -->
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Accuracy"
                                       Foreground="#9090AA" FontSize="12" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblAccuracy"
                                       Grid.Column="1"
                                       Text="91%"
                                       Foreground="#F5C518"
                                       FontSize="12" FontWeight="Bold" FontFamily="Segoe UI"/>
                        </Grid>

                        <!-- Row: Elapsed session time -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Time"
                                       Foreground="#9090AA" FontSize="12" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="lblSessionTime"
                                       Grid.Column="1"
                                       Text="12:04"
                                       Foreground="White"
                                       FontSize="12" FontWeight="Bold" FontFamily="Segoe UI"/>
                        </Grid>

                    </StackPanel>
                </Border>

                <!-- ┌─ SUGGESTED LETTERS CARD ──────────────────
                     Shows letters that are close to the detected sign.
                     WrapPanel so chips flow to the next row automatically.
                ─────────────────────────────────────────────┘ -->
                <Border x:Name="pnlSuggested"
                        Background="#20203A"
                        CornerRadius="12"
                        Padding="14,13">
                    <StackPanel>

                        <!-- Section title -->
                        <TextBlock Text="SUGGESTED"
                                   Foreground="#666688" FontSize="9"
                                   FontWeight="Bold" FontFamily="Segoe UI"
                                   Margin="0,0,0,10"/>

                        <!-- Letter chips — add/remove dynamically in code-behind -->
                        <WrapPanel x:Name="pnlSuggestedLetters">
                            <Button x:Name="btnSuggestA" Content="A"
                                    Style="{StaticResource LetterChipBtn}"
                                    ToolTip="Select A"/>
                            <Button x:Name="btnSuggestE" Content="E"
                                    Style="{StaticResource LetterChipBtn}"
                                    ToolTip="Select E"/>
                            <Button x:Name="btnSuggestI" Content="I"
                                    Style="{StaticResource LetterChipBtn}"
                                    ToolTip="Select I"/>
                            <Button x:Name="btnSuggestO" Content="O"
                                    Style="{StaticResource LetterChipBtn}"
                                    ToolTip="Select O"/>
                        </WrapPanel>

                    </StackPanel>
                </Border>

            </StackPanel>


            <!-- ════════════════════════════════════════════════
                 PREDICTED LETTER PANEL  (Bottom-Center)
                 Floats above the action buttons.
                 Shows the letter the model thinks the user is signing.
            ════════════════════════════════════════════════ -->
            <Border x:Name="pnlPredictedLetter"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,74"
                    Width="230"
                    Background="#18182C"
                    CornerRadius="18"
                    Padding="38,18,38,20">
                <StackPanel HorizontalAlignment="Center">

                    <!-- Small label above the letter -->
                    <TextBlock Text="PREDICTED LETTER"
                               Foreground="#6666AA" FontSize="9"
                               FontWeight="Bold" FontFamily="Segoe UI"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,0"/>

                    <!-- The main predicted ASL letter — large and bold -->
                    <TextBlock x:Name="lblPredictedLetter"
                               Text="W"
                               Foreground="White"
                               FontSize="72" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <!-- Confidence pill: colored dot + percentage text -->
                    <Border Background="#24243E"
                            CornerRadius="14"
                            Padding="14,5"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- Small glowing dot — color can change with confidence level -->
                            <Ellipse x:Name="dotConfidence"
                                     Width="8" Height="8"
                                     Fill="#7B61FF"
                                     VerticalAlignment="Center"
                                     Margin="0,0,7,0"/>

                            <!-- Confidence percentage text -->
                            <TextBlock x:Name="lblConfidence"
                                       Text="CONFIDENCE: 98.4%"
                                       Foreground="#7B61FF"
                                       FontSize="10" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>


            <!-- ════════════════════════════════════════════════
                 BOTTOM ACTION BUTTONS
                 Three buttons in a row at the very bottom:
                   [CLEAR]   [SUBMIT SIGN ★]   [LOG]
            ════════════════════════════════════════════════ -->
            <StackPanel x:Name="pnlBottomActions"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16">

                <!-- CLEAR — resets the current detection result and clears state -->
                <Button x:Name="btnClear"
                        Content="✕   CLEAR"
                        Style="{StaticResource ActionBtn}"
                        Background="#2A2A42"
                        Width="150"
                        Margin="0,0,10,0"
                        ToolTip="Clear the current sign"/>

                <!-- SUBMIT SIGN — confirms and logs the detected letter (primary action) -->
                <Button x:Name="btnSubmitSign"
                        Content="►   SUBMIT SIGN"
                        Style="{StaticResource ActionBtn}"
                        Background="#7B61FF"
                        FontWeight="Bold"
                        Width="188"
                        Margin="0,0,10,0"
                        ToolTip="Submit this detected sign"/>

                <!-- LOG — opens the session sign history / log view -->
                <Button x:Name="btnLog"
                        Content="🕐   LOG"
                        Style="{StaticResource ActionBtn}"
                        Background="#2A2A42"
                        Width="150"
                        ToolTip="View sign log history"/>

            </StackPanel>

        </Grid>
        <!-- End LAYER 1 -->

    </Grid>
    <!-- End ROOT GRID -->

</Page>
