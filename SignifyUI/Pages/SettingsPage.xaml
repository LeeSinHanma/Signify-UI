<Page x:Class="Signify.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="#12122A">

    <!-- ═══════════════════════════════════════════════════════════
         PAGE-LEVEL STYLES
    ═══════════════════════════════════════════════════════════ -->
    <Page.Resources>

        <!-- Base template that gives every Button a CornerRadius + hover feedback -->
        <Style x:Key="BaseRoundedBtn" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square icon button — header icons -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#252540"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="36"/>
            <Setter Property="Height"      Value="36"/>
            <Setter Property="FontSize"    Value="14"/>
        </Style>

        <!-- Category button in left sidebar -->
        <Style x:Key="CategoryBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#8888AA"/>
            <Setter Property="Width"       Value="188"/>
            <Setter Property="Height"      Value="44"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="16,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1C1C38"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active category button (highlighted) -->
        <Style x:Key="CategoryBtn_Active" TargetType="Button" BasedOn="{StaticResource CategoryBtn}">
            <Setter Property="Background"  Value="#5A45CC"/>
            <Setter Property="Foreground"  Value="White"/>
        </Style>

        <!-- Primary action button (Apply Changes) -->
        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#5A45CC"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Height"      Value="40"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="32,0"/>
        </Style>

        <!-- Secondary action button (Reset Defaults) -->
        <Style x:Key="SecondaryBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="#8888AA"/>
            <Setter Property="Height"      Value="40"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="32,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444466"/>
        </Style>

        <!-- Dark ComboBox style -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.Column="2"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="#252540"
                                          Foreground="White"
                                          BorderThickness="0"
                                          Padding="10,8"/>
                            <ContentPresenter x:Name="ContentPresenter"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="10,8"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#252540"
                                        BorderBrush="#444466"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBoxItem style -->
        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#252540"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#3C3C54"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#5A45CC"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>


    <!-- ═══════════════════════════════════════════════════════════
         ROOT: Two rows — header strip + main content area
    ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="957*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <!-- Top header bar        -->
            <RowDefinition Height="*"/>
            <!-- Everything else below -->
        </Grid.RowDefinitions>


        <!-- ════════════════════════════════════════════════════════
             ROW 0 — TOP HEADER BAR
             Back ← | Signify | Settings | ? ⚙
        ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0D0D20" Grid.ColumnSpan="2">
            
            <Grid Margin="14,0">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Back button   -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Logo text     -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Divider       -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Mode label    -->
                    <ColumnDefinition Width="*"/>
                    <!-- Spacer        -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Help/Settings -->
                </Grid.ColumnDefinitions>

                <!-- ── BACK BUTTON ── -->
                <Button x:Name="btnBack"
                        Grid.Column="0"
                        Content="←"
                        Style="{StaticResource IconBtn}"
                        ToolTip="Back to Main Menu"
                        Click="btnBack_Click"
                        Margin="0,0,12,0"/>

                <!-- ── APP LOGO ── -->
                <TextBlock x:Name="lblAppName"
                           Grid.Column="1"
                           Text="Signify"
                           Foreground="#7B61FF"
                           FontSize="20" FontWeight="Bold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
                <!-- DIVIDER -->
                <Rectangle Grid.Column="2"
                           Width="1"
                           Height="22"
                           Margin="18,0"
                           Fill="#44445C"
                           VerticalAlignment="Center"/>

                <!-- MODE LABEL -->
                <TextBlock x:Name="lblModeTitle"
                           Grid.Column="3"
                           Text="Settings"
                           Foreground="#9A9AB3"
                           FontSize="11"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <!-- ── HEADER ICON BUTTONS ── -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <!-- Opens a help dialog/overlay -->
                    <Button x:Name="btnHelp"
                            Content="?" Style="{StaticResource IconBtn}"
                            ToolTip="Help" Margin="0,0,8,0"/>
                </StackPanel>

            </Grid>
        </Border>


        <!-- ════════════════════════════════════════════════════════
             ROW 1 — MAIN CONTENT AREA  (2 columns)
               Col 0 — Category sidebar
               Col 1 — Settings content panel
        ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="8,10,12,12" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <!-- Left sidebar categories -->
                <ColumnDefinition Width="*"/>
                <!-- Main settings content -->
            </Grid.ColumnDefinitions>


            <!-- ══════════════════════════════════════════════════
                 COL 0 — CATEGORY SIDEBAR
                 List of settings categories
            ══════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="#161630"
                    CornerRadius="14"
                    Margin="0,0,10,0"
                    Padding="8,8">
                <StackPanel>

                    <!-- CATEGORIES label -->
                    <TextBlock Text="CATEGORIES"
                               Foreground="#555577"
                               FontSize="9" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Margin="12,0,0,12"/>

                    <!-- Vision & Input category (ACTIVE) -->
                    <Button x:Name="btnCatVision"
                            Style="{StaticResource CategoryBtn_Active}"
                            ToolTip="Vision &amp; Input">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📹" Margin="0,0,8,0"/>
                            <TextBlock Text="Vision &amp; Input" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Audio & Sfx category -->
                    <Button x:Name="btnCatAudio"
                            Style="{StaticResource CategoryBtn}"
                            ToolTip="Audio &amp; Sfx">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔊" Margin="0,0,8,0"/>
                            <TextBlock Text="Audio &amp; Sfx" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Calibration category -->
                    <Button x:Name="btnCatCalibration"
                            Style="{StaticResource CategoryBtn}"
                            ToolTip="Calibration">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎯" Margin="0,0,8,0"/>
                            <TextBlock Text="Calibration" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Account category -->
                    <Button x:Name="btnCatAccount"
                            Style="{StaticResource CategoryBtn}"
                            ToolTip="Account">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤" Margin="0,0,8,0"/>
                            <TextBlock Text="Account" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>


            <!-- ══════════════════════════════════════════════════
                 COL 1 — SETTINGS CONTENT
                 Displays settings for the selected category
            ══════════════════════════════════════════════════ -->
            <Border Grid.Column="1"
                    Background="#161630"
                    CornerRadius="14"
                    Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Section title -->
                        <RowDefinition Height="Auto"/>
                        <!-- Description -->
                        <RowDefinition Height="*"/>
                        <!-- Settings list -->
                        <RowDefinition Height="Auto"/>
                        <!-- Action buttons -->
                    </Grid.RowDefinitions>

                    <!-- ── SECTION TITLE ── -->
                    <TextBlock Grid.Row="0"
                               x:Name="lblSectionTitle"
                               Text="Vision &amp; Input"
                               Foreground="White"
                               FontSize="20" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Margin="0,0,0,4"/>

                    <!-- ── DESCRIPTION ── -->
                    <TextBlock Grid.Row="1"
                               x:Name="lblSectionDesc"
                               Text="Configure your camera and gesture recognition sensitivity for the best gameplay experience."
                               Foreground="#9090B0"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <!-- ── SETTINGS LIST ── -->
                    <!-- VISION & INPUT PANEL -->
                    <StackPanel Grid.Row="2" x:Name="pnlVisionSettings">

                        <!-- Setting 1: Active Camera Source -->
                        <Border Background="#1C1C38"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="ACTIVE CAMERA SOURCE"
                                               Foreground="#9090B0"
                                               FontSize="10" FontWeight="Bold"
                                               FontFamily="Segoe UI"
                                               Margin="0,0,0,8"/>
                                    <ComboBox x:Name="cmbCamera"
                                              Style="{StaticResource DarkComboBox}"
                                              SelectionChanged="cmbCamera_SelectionChanged">
                                        <ComboBoxItem Style="{StaticResource DarkComboBoxItem}" Content="Camera 0"/>
                                        <ComboBoxItem Style="{StaticResource DarkComboBoxItem}" Content="Camera 1"/>
                                        <ComboBoxItem Style="{StaticResource DarkComboBoxItem}" Content="Camera 2"/>
                                        <ComboBoxItem Style="{StaticResource DarkComboBoxItem}" Content="Camera 3"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Setting 2: Hand Sensitivity Slider -->
                        <Border Background="#1C1C38"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="HAND SENSITIVITY"
                                               Foreground="#9090B0"
                                               FontSize="10" FontWeight="Bold"
                                               FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="lblHandSensValue"
                                               Text="85%"
                                               Foreground="#D97B20"
                                               FontSize="11" FontWeight="Bold"
                                               FontFamily="Segoe UI"/>
                                </Grid>

                                <Slider x:Name="sldHandSensitivity"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="85"
                                        Margin="0,8,0,0"
                                        Foreground="#D97B20"
                                        Background="#252540"
                                        Height="6"/>

                                <TextBlock Text="Adjust how quickly the system detects hand movement."
                                           Foreground="#666688"
                                           FontSize="10"
                                           FontFamily="Segoe UI"
                                           FontStyle="Italic"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Setting 3: Confidence Threshold Slider -->
                        <Border Background="#1C1C38"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="CONFIDENCE THRESHOLD"
                                               Foreground="#9090B0"
                                               FontSize="10" FontWeight="Bold"
                                               FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="lblConfidenceThreshValue"
                                               Text="60%"
                                               Foreground="#D97B20"
                                               FontSize="11" FontWeight="Bold"
                                               FontFamily="Segoe UI"/>
                                </Grid>

                                <Slider x:Name="sldConfidenceThresh"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="60"
                                        Margin="0,8,0,0"
                                        Foreground="#D97B20"
                                        Background="#252540"
                                        Height="6"/>

                                <TextBlock Text="Lower values are more forgiving, higher values require precise signing."
                                           Foreground="#666688"
                                           FontSize="10"
                                           FontFamily="Segoe UI"
                                           FontStyle="Italic"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Toggle switches -->
                        <Border Background="#1C1C38"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Haptic Feedback toggle -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🔨 Haptic Feedback"
                                                   Foreground="White"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>

                                    <CheckBox x:Name="chkHapticFeedback"
                                              IsChecked="True"
                                              VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Dark Atmosphere toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🌙 Dark Atmosphere"
                                                   Foreground="White"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>

                                    <CheckBox x:Name="chkDarkAtmosphere"
                                              IsChecked="True"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- AUDIO & SFX PANEL -->
                    <StackPanel Grid.Row="2" x:Name="pnlAudioSettings" Visibility="Collapsed">
                        <Border Background="#1C1C38"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="0,0,0,16">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="MASTER VOLUME" Foreground="#9090B0" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/>
                                    <TextBlock Grid.Column="1" Text="75%" Foreground="#D97B20" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"/>
                                </Grid>
                                <Slider Minimum="0" Maximum="100" Value="75" Margin="0,8,0,6" Foreground="#D97B20" Background="#252540" Height="6"/>
                                <TextBlock Text="Adjust overall audio level." Foreground="#666688" FontSize="10" FontFamily="Segoe UI" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C1C38" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Sound Effects toggle -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🔊 Sound Effects" Foreground="White" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- Background Music toggle -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="🎵 Background Music" Foreground="White" FontSize="12" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="True" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- CALIBRATION PANEL -->
                    <StackPanel Grid.Row="2" x:Name="pnlCalibrationSettings" Visibility="Collapsed">
                        <Border Background="#1C1C38" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <!-- Camera Feed -->
                                <Border Background="Black" CornerRadius="8" Height="500" Margin="0,0,0,16" ClipToBounds="True">
                                    <Grid>
                                        <Image x:Name="imgCalibrationCamera" Stretch="Uniform" />
                                        <TextBlock x:Name="txtCalibrationPlaceholder" Text="[ Camera Feed ]" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Vertical" Margin="0,0,10,0">
                                        <TextBlock Text="LETTER TO TRAIN" Foreground="#9090B0" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                                        <TextBox x:Name="txtLetterToTrain" MaxLength="1" Background="#252540" Foreground="White" BorderThickness="0" Padding="10,8" Height="32"/>
                                    </StackPanel>

                                    <Button x:Name="btnCaptureCalibration" Grid.Column="1" Content="Capture" Style="{StaticResource PrimaryBtn}" Margin="0,18,10,0" Height="32" Padding="16,0" Click="btnCaptureCalibration_Click"/>
                                    <Button x:Name="btnRetrainCalibration" Grid.Column="2" Content="Retrain" Style="{StaticResource SecondaryBtn}" Margin="0,18,0,0" Height="32" Padding="16,0" Click="btnRetrainCalibration_Click"/>
                                </Grid>

                                <TextBlock x:Name="lblCalibrationStatus" Text="Ready" Foreground="#9090B0" FontSize="12" FontFamily="Segoe UI" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ACCOUNT PANEL -->
                    <StackPanel Grid.Row="2" x:Name="pnlAccountSettings" Visibility="Collapsed">
                        <Border Background="#1C1C38" CornerRadius="10" Padding="30,24" Margin="0,0,0,16">
                            <StackPanel HorizontalAlignment="Center">
                                <!-- Welcome Status -->
                                <TextBlock Text="YOUR PROFILE" Foreground="#9090B0" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                <!-- Mastery Image -->
                                <Image x:Name="imgRank"
                                       Width="120" Height="120" 
                                       Stretch="Uniform" 
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>

                                <!-- Profile Fields container -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock x:Name="lblAccountName" Text="-" Foreground="White" FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="lblAccountUsername" Text="(@-)" Foreground="#7B61FF" FontSize="14" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                                    <Border Background="#252540" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Current Mastery Level: " Foreground="#9090B0" FontSize="13" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="lblAccountMastery" Text="-" Foreground="#D97B20" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Change Password Section -->
                        <Border Background="#1C1C38" CornerRadius="10" Padding="14,10" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CHANGE PASSWORD" Foreground="#9090B0" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Old Password" Foreground="#9090B0" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <PasswordBox x:Name="txtOldPassword" Background="#252540" Foreground="White" BorderThickness="0" Padding="10,8" Height="32" FontFamily="Segoe UI" PasswordChanged="txtOldPassword_PasswordChanged"/>
                                        <TextBox x:Name="txtOldPasswordVisible" Visibility="Collapsed" Background="#252540" Foreground="White" BorderThickness="0" Padding="10,8" Height="32" FontFamily="Segoe UI" TextChanged="txtOldPasswordVisible_TextChanged"/>
                                    </Grid>
                                </Grid>
                                
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="New Password" Foreground="#9090B0" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <PasswordBox x:Name="txtNewPassword" Background="#252540" Foreground="White" BorderThickness="0" Padding="10,8" Height="32" FontFamily="Segoe UI" PasswordChanged="txtNewPassword_PasswordChanged"/>
                                        <TextBox x:Name="txtNewPasswordVisible" Visibility="Collapsed" Background="#252540" Foreground="White" BorderThickness="0" Padding="10,8" Height="32" FontFamily="Segoe UI" TextChanged="txtNewPasswordVisible_TextChanged"/>
                                    </Grid>
                                </Grid>
                                
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Confirm Password" Foreground="#9090B0" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                    <Grid Grid.Column="1">
                                        <PasswordBox x:Name="txtConfirmPassword" Background="#252540" Foreground="White" BorderThickness="0" Padding="10,8" Height="32" FontFamily="Segoe UI" PasswordChanged="txtConfirmPassword_PasswordChanged"/>
                                        <TextBox x:Name="txtConfirmPasswordVisible" Visibility="Collapsed" Background="#252540" Foreground="White" BorderThickness="0" Padding="10,8" Height="32" FontFamily="Segoe UI" TextChanged="txtConfirmPasswordVisible_TextChanged"/>
                                    </Grid>
                                </Grid>
                                
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="chkShowPasswords" Content="Show Passwords" Foreground="#9090B0" FontSize="12" FontFamily="Segoe UI" VerticalAlignment="Center" Checked="chkShowPasswords_CheckedChanged" Unchecked="chkShowPasswords_CheckedChanged"/>
                                    <Button x:Name="btnChangePassword" Grid.Column="1" Content="Change Password" Style="{StaticResource SecondaryBtn}" HorizontalAlignment="Right" Click="BtnChangePassword_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ── ACTION BUTTONS ── -->
                    <Grid Grid.Row="3"
                          Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Logout button (center) -->
                        <Button x:Name="btnLogout"
                                Grid.Column="0"
                                Background="#DC3545"
                                Foreground="White"
                                Height="40"
                                Width="200"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Content="Logout"
                                Click="BtnLogout_Click"/>
                    </Grid>

                </Grid>
            </Border>

        </Grid>

    </Grid>
</Page>
