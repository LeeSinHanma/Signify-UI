<Page x:Class="Signify.Pages.LearnPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Learn Mode"
      Background="#12122A">

    <!-- ═══════════════════════════════════════════════════════════
         PAGE-LEVEL STYLES
    ═══════════════════════════════════════════════════════════ -->
    <Page.Resources>

        <!-- Base template that gives every Button a CornerRadius + hover feedback -->
        <Style x:Key="BaseRoundedBtn" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square icon button — header icons and sidebar icons -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#252540"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="36"/>
            <Setter Property="Height"      Value="36"/>
            <Setter Property="FontSize"    Value="14"/>
        </Style>

        <!-- Alphabet tile: SELECTED state (purple filled) -->
        <Style x:Key="LetterBtn_Active" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#7B61FF"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="62"/>
            <Setter Property="Height"      Value="62"/>
            <Setter Property="Margin"      Value="4"/>
        </Style>

        <!-- Alphabet tile: UNLOCKED / default state (dark, white text) -->
        <Style x:Key="LetterBtn_Unlocked" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#1C1C38"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="62"/>
            <Setter Property="Height"      Value="62"/>
            <Setter Property="Margin"      Value="4"/>
        </Style>

        <!-- Navigation tab: transparent, underline added manually per tab -->
        <Style x:Key="NavTabBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#8888AA"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Previous/Next letter navigation buttons -->
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Height"      Value="44"/>
            <Setter Property="Padding"     Value="20,0"/>
        </Style>

        <!-- Day chip buttons in the Practice Streak row -->
        <Style x:Key="DayChipBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Width"       Value="48"/>
            <Setter Property="Height"      Value="48"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="Bold"/>
        </Style>

    </Page.Resources>


    <!-- ═══════════════════════════════════════════════════════════
         ROOT: Two rows — header strip + main content area
    ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="957*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <!-- Top header bar        -->
            <RowDefinition Height="*"/>
            <!-- Everything else below -->
        </Grid.RowDefinitions>


        <!-- ════════════════════════════════════════════════════════
             ROW 0 — TOP HEADER BAR
             Back ← | Signify | Learn Mode | ? ⚙
        ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0D0D20" Grid.ColumnSpan="2">

            <Grid Margin="14,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Back button   -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Logo text     -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Divider       -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Mode label    -->
                    <ColumnDefinition Width="*"/>
                    <!-- User label (flex; ends before icons) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Help/Settings icons -->
                </Grid.ColumnDefinitions>

                <!-- ── BACK BUTTON ── -->
                <Button x:Name="btnBack"
                        Grid.Column="0"
                        Content="←"
                        Style="{StaticResource IconBtn}"
                        ToolTip="Back to Main Menu"
                        Click="btnBack_Click"
                        Margin="0,0,12,0"/>

                <!-- ── APP LOGO ── -->
                <TextBlock x:Name="lblAppName"
                           Grid.Column="1"
                           Text="Signify"
                           Foreground="#7B61FF"
                           FontSize="20" FontWeight="Bold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
                <!-- DIVIDER -->
                <Rectangle Grid.Column="2"
                           Width="1"
                           Height="22"
                           Margin="18,0"
                           Fill="#44445C"
                           VerticalAlignment="Center"/>

                <!-- MODE LABEL -->
                <TextBlock x:Name="lblModeTitle"
                           Grid.Column="3"
                           Text="Learn Mode"
                           Foreground="#9A9AB3"
                           FontSize="11"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>

                <!-- USER DISPLAY -->
                <TextBlock x:Name="txtUserDisplay"
                           Grid.Column="4"
                           HorizontalAlignment="Right"
                           Foreground="#8888AA"
                           FontSize="11"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           Text=""
                           TextTrimming="CharacterEllipsis"/>

                <!-- ── HEADER ICON BUTTONS ── -->
                <StackPanel Grid.Column="5"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="btnHelp"
                            Content="?" Style="{StaticResource IconBtn}"
                            ToolTip="Help" Margin="0,0,8,0"/>
                    <Button x:Name="btnSettings"
                            Content="⚙" Style="{StaticResource IconBtn}"
                            ToolTip="Settings"/>
                </StackPanel>

            </Grid>
        </Border>


        <!-- ════════════════════════════════════════════════════════
             ROW 1 — MAIN CONTENT AREA  (3 columns)
               Col 0 — Alphabet Library panel
               Col 1 — Live cam + AI recognition (MOVED HERE)
               Col 2 — Hand sign image + tip + nav (MOVED HERE)
        ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="8,10,12,12" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <!-- Left panel  -->
                <ColumnDefinition Width="*"/>
                <!-- Center — camera -->
                <ColumnDefinition Width="276"/>
                <!-- Right panel — hand sign -->
            </Grid.ColumnDefinitions>


            <!-- ══════════════════════════════════════════════════
                 COL 0 — ALPHABET LIBRARY
                 All 26 letters are now clickable and unlocked.
                 Click handler: btnLetter_Click in code-behind.
            ══════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="#161630"
                    CornerRadius="14"
                    Margin="0,0,10,0"
                    Padding="12,14">
                <StackPanel>

                    <!-- Panel heading -->
                    <TextBlock Text="Alphabet Library"
                               Foreground="White"
                               FontSize="16" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Margin="0,0,0,2"/>

                    <!-- Mastery progress counter -->
                    <TextBlock x:Name="lblMastery"
                               Text="MASTERY: 12 / 26"
                               Foreground="#555577"
                               FontSize="9" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Margin="0,0,0,12"/>

                    <!-- Scrollable grid of all 26 letter tiles -->
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <UniformGrid x:Name="gridAlphabet" Columns="3">

                            <!-- ── A  (ACTIVE / selected by default) ── -->
                            <Button x:Name="btnLetterA"
                                    Tag="A"
                                    Style="{StaticResource LetterBtn_Active}"
                                    Click="btnLetter_Click"
                                    ToolTip="Letter A">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="A" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="White" Width="22"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- ── B through Z — all unlocked, all clickable ── -->
                            <Button x:Name="btnLetterB" Tag="B"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter B">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="B" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterC" Tag="C"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter C">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="C" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterD" Tag="D"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter D">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="D" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterE" Tag="E"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter E">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="E" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterF" Tag="F"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter F">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="F" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterG" Tag="G"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter G">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="G" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterH" Tag="H"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter H">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="H" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterI" Tag="I"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter I">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="I" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterJ" Tag="J"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter J">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="J" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterK" Tag="K"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter K">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="K" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterL" Tag="L"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter L">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="L" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterM" Tag="M"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter M">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="M" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterN" Tag="N"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter N">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="N" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterO" Tag="O"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter O">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="O" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterP" Tag="P"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter P">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="P" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterQ" Tag="Q"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter Q">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Q" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterR" Tag="R"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter R">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="R" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterS" Tag="S"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter S">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="S" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterT" Tag="T"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter T">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="T" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterU" Tag="U"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter U">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="U" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterV" Tag="V"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter V">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="V" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterW" Tag="W"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter W">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="W" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterX" Tag="X"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter X">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="X" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterY" Tag="Y"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter Y">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Y" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnLetterZ" Tag="Z"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    Click="btnLetter_Click" ToolTip="Letter Z">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Z" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                        </UniformGrid>
                    </ScrollViewer>
                </StackPanel>
            </Border>


            <!-- ══════════════════════════════════════════════════
                 COL 1 — CENTER: Live cam + AI recognition
                 (Previously was in Col 2 — now moved to center)
            ══════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Camera feed card  -->
                    <RowDefinition Height="Auto"/>
                    <!-- Pro Tip card at bottom -->
                </Grid.RowDefinitions>

                <!-- ── LIVE CAMERA CARD ── -->
                <Border Grid.Row="0"
                        x:Name="pnlCameraCard"
                        Background="#0E1A20"
                        CornerRadius="14"
                        Margin="0,0,0,10"
                        ClipToBounds="True">
                    <Grid>

                        <!-- Camera feed: dark backing + live Image + placeholder text -->
                        <Rectangle x:Name="rectCameraFeed" Fill="#0A1218"/>
                        <Image x:Name="imgCameraFeed"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"/>
                        <TextBlock x:Name="txtCameraPlaceholder"
                                   Text="[ Live Camera ]"
                                   Foreground="#1A3A30" FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <!-- LIVE CAM badge — top-left of camera -->
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10,10,0,0"
                                Background="#CC220000"
                                CornerRadius="10"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dotLive"
                                         Width="8" Height="8"
                                         Fill="#FF3A3A"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <TextBlock Text="LIVE CAM"
                                           Foreground="White"
                                           FontSize="9" FontWeight="Bold"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- Screenshot button — top-right of camera -->
                        <Button x:Name="btnCameraScreenshot"
                                Content="📸"
                                Style="{StaticResource IconBtn}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,10,10,0"
                                ToolTip="Take Screenshot"/>

                        <!-- AI RECOGNITION result panel — bottom of camera card -->
                        <Border x:Name="pnlAiRecognition"
                                VerticalAlignment="Bottom"
                                Background="#CC0A0A1A"
                                Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="AI RECOGNITION"
                                               Foreground="#666688"
                                               FontSize="9" FontWeight="Bold"
                                               FontFamily="Segoe UI"
                                               Margin="0,0,0,4"/>
                                    <TextBlock x:Name="lblMatchPct"
                                               Text="Confidence: —"
                                               Foreground="White"
                                               FontSize="20" FontWeight="Bold"
                                               FontFamily="Segoe UI"/>
                                </StackPanel>

                                <!-- Detected letter chip + checkmark -->
                                <Border Grid.Column="1"
                                        Background="#7B61FF"
                                        CornerRadius="10"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="lblDetectedLetter"
                                                   Text="A"
                                                   Foreground="White"
                                                   FontSize="18" FontWeight="Bold"
                                                   FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock x:Name="lblMatchCheck"
                                                   Text="✔"
                                                   Foreground="#A0FFA0"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>

                    </Grid>
                </Border>

                <!-- ── PRO TIP CARD ── -->
                <Border Grid.Row="1"
                        x:Name="pnlProTip"
                        Background="#161630"
                        CornerRadius="14"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="18"
                                Background="#2A2418"
                                BorderBrush="#F5C518"
                                BorderThickness="2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="💡" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Pro Tip"
                                       Foreground="White"
                                       FontSize="12" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Margin="0,0,0,2"/>
                            <TextBlock x:Name="lblProTipText"
                                       Text="Keep your thumb pressed against the side of your index finger."
                                       Foreground="#8888AA"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button x:Name="btnPlayTipAudio"
                                Grid.Column="2"
                                Content="🔊"
                                Style="{StaticResource IconBtn}"
                                ToolTip="Play Audio Tip"
                                Margin="10,0,0,0"/>
                    </Grid>
                </Border>

            </Grid>


            <!-- ══════════════════════════════════════════════════
                 COL 2 — RIGHT: Letter detail card + hand sign image + nav
                 (Previously was in Col 1 — now moved to the right)
            ══════════════════════════════════════════════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Letter card + image + nav -->
                </Grid.RowDefinitions>

                <!-- ── LETTER DETAIL CARD ── -->
                <Border Grid.Row="0"
                        Background="#161630"
                        CornerRadius="14"
                        Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Title + badge      -->
                            <RowDefinition Height="Auto"/>
                            <!-- ASL subtitle       -->
                            <RowDefinition Height="*"/>
                            <!-- Hand sign image    -->
                            <RowDefinition Height="Auto"/>
                            <!-- Prev / Next buttons -->
                        </Grid.RowDefinitions>

                        <!-- Letter title + difficulty badge -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="lblLetterTitle"
                                       Text="Letter A"
                                       Foreground="White"
                                       FontSize="28" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>

                            <Border Grid.Column="1"
                                    Background="#2A2418"
                                    BorderBrush="#F5C518"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " Foreground="#F5C518" FontSize="11"/>
                                    <TextBlock x:Name="lblDifficulty"
                                               Text="BEGINNER"
                                               Foreground="#F5C518"
                                               FontSize="10" FontWeight="Bold"
                                               FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ASL subtitle + per-letter progress -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <TextBlock Text="AMERICAN SIGN LANGUAGE"
                                       Foreground="#555577"
                                       FontSize="10" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Margin="0,0,0,6"/>
                            <TextBlock x:Name="lblLetterProgressDetail"
                                       Text="Progress: 0 / 10 (not started)"
                                       Foreground="#8888AA"
                                       FontSize="11"
                                       FontFamily="Segoe UI"/>
                        </StackPanel>

                        <!-- Hand sign reference image -->
                        <Border Grid.Row="2"
                                Background="#1A1A30"
                                CornerRadius="12"
                                Margin="0,0,0,16">
                            <Grid>
                                <Image x:Name="imgHandSign"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="[ Hand Sign Image ]"
                                           Foreground="#333355" FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Previous / Next Letter navigation buttons -->
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Button x:Name="btnPrevLetter"
                                    Content="◄  Prev"
                                    Style="{StaticResource NavBtn}"
                                    Background="#1E1E38"
                                    Width="110"
                                    Margin="0,0,10,0"
                                    Click="btnPrevLetter_Click"
                                    ToolTip="Previous Letter"/>

                            <Button x:Name="btnNextLetter"
                                    Style="{StaticResource NavBtn}"
                                    Background="#7B61FF"
                                    FontWeight="Bold"
                                    Width="110"
                                    Click="btnNextLetter_Click"
                                    ToolTip="Next Letter">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Next" Foreground="White"
                                               FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" ►" Foreground="White"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
            <!-- End Col 2 -->

        </Grid>
        <!-- End 3-column content grid -->

    </Grid>
    <!-- End root grid -->

</Page>
