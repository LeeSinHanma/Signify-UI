<Page x:Class="Signify.Pages.LearnPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Learn Mode"
      Background="#12122A">

    <!-- ═══════════════════════════════════════════════════════════
         PAGE-LEVEL STYLES
    ═══════════════════════════════════════════════════════════ -->
    <Page.Resources>

        <!-- Base template that gives every Button a CornerRadius + hover feedback -->
        <Style x:Key="BaseRoundedBtn" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square icon button — header icons and sidebar icons -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#252540"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="36"/>
            <Setter Property="Height"      Value="36"/>
            <Setter Property="FontSize"    Value="14"/>
        </Style>

        <!-- Alphabet tile: SELECTED state (purple filled) -->
        <Style x:Key="LetterBtn_Active" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#7B61FF"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="62"/>
            <Setter Property="Height"      Value="62"/>
            <Setter Property="Margin"      Value="4"/>
        </Style>

        <!-- Alphabet tile: UNLOCKED but not selected (dark, white text) -->
        <Style x:Key="LetterBtn_Unlocked" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#1C1C38"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="62"/>
            <Setter Property="Height"      Value="62"/>
            <Setter Property="Margin"      Value="4"/>
        </Style>

        <!-- Alphabet tile: LOCKED state (dimmed, lock icon shown) -->
        <Style x:Key="LetterBtn_Locked" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#14142A"/>
            <Setter Property="Foreground"  Value="#444460"/>
            <Setter Property="Width"       Value="62"/>
            <Setter Property="Height"      Value="62"/>
            <Setter Property="Margin"      Value="4"/>
        </Style>

        <!-- Navigation tab: transparent, underline added manually per tab -->
        <Style x:Key="NavTabBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="#8888AA"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="4,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Previous/Next letter navigation buttons -->
        <Style x:Key="NavBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Height"      Value="44"/>
            <Setter Property="Padding"     Value="20,0"/>
        </Style>

        <!-- Day chip buttons in the Practice Streak row -->
        <Style x:Key="DayChipBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Width"       Value="48"/>
            <Setter Property="Height"      Value="48"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="Bold"/>
        </Style>

    </Page.Resources>


    <!-- ═══════════════════════════════════════════════════════════
         ROOT: Two rows — header strip + main content area
    ═══════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="957*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <!-- Top header bar        -->
            <RowDefinition Height="*"/>
            <!-- Everything else below -->
        </Grid.RowDefinitions>


        <!-- ════════════════════════════════════════════════════════
             ROW 0 — TOP HEADER BAR
             Back ← | Signify | Learn Mode | ? ⚙
        ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#0D0D20" Grid.ColumnSpan="2">
            
            <Grid Margin="14,0">
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Back button   -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Logo text     -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Nav tabs      -->
                    <ColumnDefinition Width="*"/>
                    <!-- Spacer        -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Help/Settings -->
                </Grid.ColumnDefinitions>

                <!-- ── BACK BUTTON ──
                     Navigates back to the main menu via NavigationService.
                     Click handler is wired in the code-behind.               -->
                <Button x:Name="btnBack"
                        Grid.Column="0"
                        Content="←"
                        Style="{StaticResource IconBtn}"
                        ToolTip="Back to Main Menu"
                        Click="btnBack_Click"
                        Margin="0,0,12,0"/>

                <!-- ── APP LOGO ── -->
                <TextBlock x:Name="lblAppName"
                           Grid.Column="1"
                           Text="Signify"
                           Foreground="#7B61FF"
                           FontSize="20" FontWeight="Bold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>
                <!-- DIVIDER -->
                <Rectangle Grid.Column="2"
                           Width="1"
                           Height="22"
                           Margin="18,0"
                           Fill="#44445C"
                           VerticalAlignment="Center"/>

                <!-- MODE LABEL -->
                <TextBlock x:Name="lblModeTitle"
                           Grid.Column="3"
                           Text="Learn Mode"
                           Foreground="#9A9AB3"
                           FontSize="11"
                           FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>

                <!-- ── HEADER ICON BUTTONS ── -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Opens a help dialog/overlay -->
                    <Button x:Name="btnHelp"
                            Content="?" Style="{StaticResource IconBtn}"
                            ToolTip="Help" Margin="0,0,8,0"/>
                    <!-- Navigates to Settings page -->
                    <Button x:Name="btnSettings"
                            Content="⚙" Style="{StaticResource IconBtn}"
                            ToolTip="Settings"/>
                </StackPanel>

            </Grid>
        </Border>


        <!-- ════════════════════════════════════════════════════════
             ROW 1 — MAIN CONTENT AREA  (3 columns)
               Col 0 — Alphabet Library panel
               Col 1 — Letter detail + image + tip
               Col 2 — Live cam + AI recognition + streak
        ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="8,10,12,12" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224"/>
                <!-- Left panel  -->
                <ColumnDefinition Width="*"/>
                <!-- Center      -->
                <ColumnDefinition Width="276"/>
                <!-- Right panel -->
            </Grid.ColumnDefinitions>


            <!-- ══════════════════════════════════════════════════
                 COL 0 — ALPHABET LIBRARY
                 Title + mastery counter + scrollable letter grid.
                 Three states: Active (purple), Unlocked, Locked.
            ══════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="#161630"
                    CornerRadius="14"
                    Margin="0,0,10,0"
                    Padding="12,14">
                <StackPanel>

                    <!-- Panel heading -->
                    <TextBlock Text="Alphabet Library"
                               Foreground="White"
                               FontSize="16" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Margin="0,0,0,2"/>

                    <!-- Mastery progress counter — update Text in code-behind -->
                    <TextBlock x:Name="lblMastery"
                               Text="MASTERY: 12 / 26"
                               Foreground="#555577"
                               FontSize="9" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Margin="0,0,0,12"/>

                    <!-- Scrollable grid of all 26 letter tiles -->
                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <UniformGrid x:Name="gridAlphabet" Columns="3">

                            <!-- ── A  (ACTIVE / selected) ── -->
                            <Button x:Name="btnLetterA"
                                    Style="{StaticResource LetterBtn_Active}"
                                    ToolTip="Letter A">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="A" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <!-- Progress underline shown on active tile -->
                                    <Rectangle Height="2" Fill="White" Width="22"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- ── B  (UNLOCKED, not selected) ── -->
                            <Button x:Name="btnLetterB"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    ToolTip="Letter B">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="B" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- ── C  (UNLOCKED) ── -->
                            <Button x:Name="btnLetterC"
                                    Style="{StaticResource LetterBtn_Unlocked}"
                                    ToolTip="Letter C">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="C" FontSize="18" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                    <Rectangle Height="2" Fill="#444466" Width="22"
                                               Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>

                            <!-- ── D through Z  (LOCKED) ──
                                 All share the LetterBtn_Locked style.
                                 Lock icon signals the letter is not yet unlocked. -->
                            <Button x:Name="btnLetterD" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="D" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterE" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="E" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterF" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="F" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterG" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="G" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterH" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="H" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterI" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="I" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterJ" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="J" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterK" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="K" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterL" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="L" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterM" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="M" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterN" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="N" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterO" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="O" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterP" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="P" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterQ" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Q" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterR" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="R" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterS" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="S" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterT" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="T" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterU" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="U" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterV" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="V" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterW" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="W" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterX" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="X" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterY" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Y" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnLetterZ" Style="{StaticResource LetterBtn_Locked}" ToolTip="Locked">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Z" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="🔒" FontSize="8"  HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Button>

                        </UniformGrid>
                    </ScrollViewer>
                </StackPanel>
            </Border>


            <!-- ══════════════════════════════════════════════════
                 COL 1 — CENTER: Letter detail, image, tip
            ══════════════════════════════════════════════════ -->
            <Grid Grid.Column="1" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Letter card + image + nav  -->
                    <RowDefinition Height="Auto"/>
                    <!-- Pro Tip card at bottom     -->
                </Grid.RowDefinitions>

                <!-- ── LETTER DETAIL CARD ── -->
                <Border Grid.Row="0"
                        Background="#161630"
                        CornerRadius="14"
                        Margin="0,0,0,10"
                        Padding="20,18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Title + badge      -->
                            <RowDefinition Height="Auto"/>
                            <!-- ASL subtitle       -->
                            <RowDefinition Height="*"/>
                            <!-- Hand sign image    -->
                            <RowDefinition Height="Auto"/>
                            <!-- Prev / Next buttons -->
                        </Grid.RowDefinitions>

                        <!-- Letter title + difficulty badge side by side -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Current letter name — update Text in code-behind -->
                            <TextBlock x:Name="lblLetterTitle"
                                       Text="Letter A"
                                       Foreground="White"
                                       FontSize="28" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       VerticalAlignment="Center"/>

                            <!-- BEGINNER difficulty badge (pill shape) -->
                            <Border Grid.Column="1"
                                    Background="#2A2418"
                                    BorderBrush="#F5C518"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡ " Foreground="#F5C518" FontSize="11"/>
                                    <TextBlock x:Name="lblDifficulty"
                                               Text="BEGINNER"
                                               Foreground="#F5C518"
                                               FontSize="10" FontWeight="Bold"
                                               FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ASL subtitle label -->
                        <TextBlock Grid.Row="1"
                                   Text="AMERICAN SIGN LANGUAGE"
                                   Foreground="#555577"
                                   FontSize="10" FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   Margin="0,0,0,14"/>

                        <!-- Hand sign reference image placeholder
                             Replace Source with actual image path per letter -->
                        <Border Grid.Row="2"
                                Background="#1A1A30"
                                CornerRadius="12"
                                Margin="0,0,0,16">
                            <Grid>
                                <!-- Swap this Image.Source when backend loads assets -->
                                <Image x:Name="imgHandSign"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <!-- Shown only while image source is empty -->
                                <TextBlock Text="[ Hand Sign Image ]"
                                           Foreground="#333355" FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"/>
                            </Grid>
                        </Border>

                        <!-- Previous / Next Letter navigation buttons -->
                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <!-- Goes to the previous ASL letter -->
                            <Button x:Name="btnPrevLetter"
                                    Content="◄  Previous"
                                    Style="{StaticResource NavBtn}"
                                    Background="#1E1E38"
                                    Width="140"
                                    Margin="0,0,12,0"
                                    ToolTip="Previous Letter"/>

                            <!-- Goes to the next ASL letter (primary action, purple) -->
                            <Button x:Name="btnNextLetter"
                                    Style="{StaticResource NavBtn}"
                                    Background="#7B61FF"
                                    FontWeight="Bold"
                                    Width="140"
                                    ToolTip="Next Letter">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Next" Foreground="White"
                                               FontSize="13" FontWeight="Bold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text=" Letter  ►" Foreground="White"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── PRO TIP CARD ──
                     Shows a contextual tip for the current letter.
                     Update lblProTipText in code-behind per letter.     -->
                <Border Grid.Row="1"
                        x:Name="pnlProTip"
                        Background="#161630"
                        CornerRadius="14"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <!-- Circle icon     -->
                            <ColumnDefinition Width="*"/>
                            <!-- Tip text        -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- Audio icon      -->
                        </Grid.ColumnDefinitions>

                        <!-- Decorative yellow circle icon -->
                        <Border Grid.Column="0"
                                Width="36" Height="36"
                                CornerRadius="18"
                                Background="#2A2418"
                                BorderBrush="#F5C518"
                                BorderThickness="2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="💡" FontSize="14"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- Tip content: heading + body -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Pro Tip"
                                       Foreground="White"
                                       FontSize="12" FontWeight="Bold"
                                       FontFamily="Segoe UI"
                                       Margin="0,0,0,2"/>
                            <!-- Update this text when the user selects a letter -->
                            <TextBlock x:Name="lblProTipText"
                                       Text="Keep your thumb pressed against the side of your index finger."
                                       Foreground="#8888AA"
                                       FontSize="11"
                                       FontFamily="Segoe UI"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Audio play button — plays tip audio later -->
                        <Button x:Name="btnPlayTipAudio"
                                Grid.Column="2"
                                Content="🔊"
                                Style="{StaticResource IconBtn}"
                                ToolTip="Play Audio Tip"
                                Margin="10,0,0,0"/>
                    </Grid>
                </Border>

            </Grid>


            <!-- ══════════════════════════════════════════════════
                 COL 2 — RIGHT: Live cam + AI result + streak
            ══════════════════════════════════════════════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <!-- Camera feed card  -->
                    <RowDefinition Height="Auto"/>
                    <!-- Practice streak   -->
                </Grid.RowDefinitions>

                <!-- ── LIVE CAMERA CARD ── -->
                <Border Grid.Row="0"
                        x:Name="pnlCameraCard"
                        Background="#0E1A20"
                        CornerRadius="14"
                        Margin="0,0,0,10"
                        ClipToBounds="True">
                    <Grid>

                        <!-- Camera feed placeholder — swap with WritableBitmap -->
                        <Rectangle x:Name="rectCameraFeed" Fill="#0A1218"/>
                        <TextBlock Text="[ Live Camera ]"
                                   Foreground="#1A3A30" FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>

                        <!-- LIVE CAM badge — top-left of camera -->
                        <Border HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Margin="10,10,0,0"
                                Background="#CC220000"
                                CornerRadius="10"
                                Padding="8,4">
                            <StackPanel Orientation="Horizontal">
                                <!-- Pulsing red dot indicator -->
                                <Ellipse x:Name="dotLive"
                                         Width="8" Height="8"
                                         Fill="#FF3A3A"
                                         VerticalAlignment="Center"
                                         Margin="0,0,6,0"/>
                                <TextBlock Text="LIVE CAM"
                                           Foreground="White"
                                           FontSize="9" FontWeight="Bold"
                                           FontFamily="Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- Screenshot button — top-right of camera -->
                        <Button x:Name="btnCameraScreenshot"
                                Content="📸"
                                Style="{StaticResource IconBtn}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,10,10,0"
                                ToolTip="Take Screenshot"/>

                        <!-- AI RECOGNITION result panel — bottom of camera card -->
                        <Border x:Name="pnlAiRecognition"
                                VerticalAlignment="Bottom"
                                Background="#CC0A0A1A"
                                Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <!-- Section label -->
                                    <TextBlock Text="AI RECOGNITION"
                                               Foreground="#666688"
                                               FontSize="9" FontWeight="Bold"
                                               FontFamily="Segoe UI"
                                               Margin="0,0,0,4"/>
                                    <!-- Match percentage — update lblMatchPct in code-behind -->
                                    <TextBlock x:Name="lblMatchPct"
                                               Text="Matching: 89%"
                                               Foreground="White"
                                               FontSize="20" FontWeight="Bold"
                                               FontFamily="Segoe UI"/>
                                </StackPanel>

                                <!-- Detected letter chip + checkmark -->
                                <Border Grid.Column="1"
                                        Background="#7B61FF"
                                        CornerRadius="10"
                                        Padding="10,6"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Detected letter — update lblDetectedLetter.Text -->
                                        <TextBlock x:Name="lblDetectedLetter"
                                                   Text="A"
                                                   Foreground="White"
                                                   FontSize="18" FontWeight="Bold"
                                                   FontFamily="Segoe UI"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <!-- Checkmark shown when detection matches target -->
                                        <TextBlock x:Name="lblMatchCheck"
                                                   Text="✔"
                                                   Foreground="#A0FFA0"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                            </Grid>
                        </Border>

                    </Grid>
                </Border>

            </Grid>
            <!-- End Col 2 -->

        </Grid>
        <!-- End 3-column content grid -->

    </Grid>
    <!-- End root grid -->

</Page>
