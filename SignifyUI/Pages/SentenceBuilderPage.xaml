<Page x:Class="Signify.Pages.SentenceBuilderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Sentence Builder"
      Background="#12122A">

    <Page.Resources>

        <Style x:Key="BaseRoundedBtn" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#252540"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="36"/>
            <Setter Property="Height"      Value="36"/>
            <Setter Property="FontSize"    Value="14"/>
        </Style>

        <Style x:Key="SidebarActionBtn" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#1C1C38"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="48"/>
            <Setter Property="Height"      Value="48"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,6"/>
        </Style>

        <Style x:Key="LetterTile_Active" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"  Value="#D97B20"/>
            <Setter Property="Foreground"  Value="White"/>
            <Setter Property="Width"       Value="48"/>
            <Setter Property="Height"      Value="48"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Margin"      Value="4"/>
        </Style>

        <Style x:Key="LetterTile_Empty" TargetType="Button" BasedOn="{StaticResource BaseRoundedBtn}">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#555577"/>
            <Setter Property="Width"           Value="48"/>
            <Setter Property="Height"          Value="48"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="Margin"          Value="4"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BorderBrush"     Value="#444466"/>
        </Style>

    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="957*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0 — TOP HEADER BAR -->
        <Border Grid.Row="0" Background="#0D0D20" Grid.ColumnSpan="2">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnBack"
                        Grid.Column="0"
                        Content="←"
                        Style="{StaticResource IconBtn}"
                        ToolTip="Back to Main Menu"
                        Click="btnBack_Click"
                        Margin="0,0,12,0"/>

                <TextBlock x:Name="lblAppName"
                           Grid.Column="1"
                           Text="Signify"
                           Foreground="#7B61FF"
                           FontSize="20" FontWeight="Bold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Margin="0,0,24,0"/>

                <Rectangle Grid.Column="2"
                           Width="1" Height="22"
                           Margin="18,0"
                           Fill="#44445C"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="lblModeTitle"
                           Grid.Column="3"
                           Text="Sentence Builder"
                           Foreground="#9A9AB3"
                           FontSize="11" FontWeight="SemiBold"
                           FontFamily="Segoe UI"
                           VerticalAlignment="Center"
                           Margin="18,0,0,0"/>

                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="btnSettings"
                            Content="⚙" Style="{StaticResource IconBtn}"
                            ToolTip="Settings"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ROW 1 — MAIN CONTENT AREA -->
        <Grid Grid.Row="1" Margin="8,10,12,12" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0"
                    Background="#161630"
                    CornerRadius="14"
                    Margin="0,0,10,0"
                    Padding="8,12"
                    Width="64">
                <StackPanel VerticalAlignment="Top">

                    <Button x:Name="btnClear"
                            Style="{StaticResource SidebarActionBtn}"
                            ToolTip="Clear all"
                            Click="btnClear_Click">
                        <StackPanel>
                            <TextBlock Text="⟲" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                            <TextBlock Text="CLEAR" FontSize="8" HorizontalAlignment="Center" Foreground="#9090B0"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ROW 0 — SENTENCE DISPLAY -->
                <Border Grid.Row="0"
                        Background="#1A1A32"
                        CornerRadius="14"
                        Padding="20,16"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Sentence:"
                                   Foreground="#9090B0"
                                   FontSize="11" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <Border Grid.Column="1"
                                Background="#252540"
                                CornerRadius="8"
                                Padding="12,10">
                            <TextBlock x:Name="lblSentence"
                                       Text=""
                                       Foreground="White"
                                       FontSize="16" FontWeight="SemiBold"
                                       FontFamily="Segoe UI"
                                       TextWrapping="Wrap"
                                       LineHeight="24"
                                       MinHeight="40"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ROW 1 — CAMERA FEED -->
                <Border Grid.Row="1"
                        Background="#1A1A32"
                        CornerRadius="14"
                        Margin="0,0,0,12"
                        Padding="16">
                    <Grid>
                        <Border x:Name="rectCameraFeed"
                                Background="#252540"
                                CornerRadius="10"/>
                        <Image x:Name="imgCameraFeed"
                               Stretch="UniformToFill"/>

                        <TextBlock x:Name="txtCameraPlaceholder"
                                   Text="[ Camera Feed ]"
                                   Foreground="#44445A" FontSize="18" FontStyle="Italic"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,20,0,0"
                                   Visibility="Visible"
                                   IsHitTestVisible="False"/>

                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="#1C1C38"
                                CornerRadius="10"
                                Padding="16,12"
                                Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="dotConfidence"
                                         Width="12" Height="12"
                                         Fill="#D97B20"
                                         Margin="0,0,12,0"
                                         VerticalAlignment="Center"/>
                                <TextBlock x:Name="lblDetectedLetter"
                                           Text="-"
                                           Foreground="White"
                                           FontSize="18" FontWeight="Bold"
                                           Margin="0,0,16,0"/>
                                <TextBlock x:Name="lblConfidence"
                                           Text="CONFIDENCE: --"
                                           Foreground="#9090B0"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ROW 2 — LETTER TILES -->
                <Border Grid.Row="2"
                        Background="#1A1A32"
                        CornerRadius="14"
                        Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="Current Word"
                                   Foreground="#9090B0"
                                   FontSize="10" FontWeight="SemiBold"
                                   Margin="0,0,0,8"/>

                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="pnlLetterTiles"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <!-- Tiles populated dynamically from code-behind -->
                            </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

    </Grid>
</Page>